 {
  "method": "selectionLines",
  "params": {
   "repo": "$repo",
   "worktree": "$wt",
   "path": "src/app.txt",
   "staged": false,
   "selection": {
    "kind": "hunks",
    "hunks": [
     1
    ]
   }
  }
 },
 {
  "method": "selectionLines",
  "params": {
   "repo": "$repo",
   "worktree": "$wt",
   "path": "src/app.txt",
   "staged": false,
   "selection": {
    "kind": "lines",
    "old": [
     {
      "start": 20,
      "end": 20
     }
    ],
    "new": [
     {
      "start": 20,
      "end": 20
     }
    ]
   }
  }
 },
 {
  "method": "selectionLines",
  "params": {
   "repo": "$repo",
   "worktree": "$wt",
   "path": "notes.txt",
   "staged": true,
   "selection": {
    "kind": "hunks",
    "hunks": [
     0
    ]
   }
  }
 },
 {
  "method": "diffContents",
  "params": {
   "repo": "$repo",
   "path": "notes.txt",
   "old": {
    "kind": "object",
    "oid": {
     "$rev": ":notes.txt"
    }
   },
   "new": {
    "kind": "worktree",
    "worktree": "$wt"
   },
   "force": false
  }
 },
 {
  "method": "diffContents",
  "params": {
   "repo": "$repo",
   "path": "new.txt",
   "old": {
    "kind": "absent"
   },
   "new": {
    "kind": "worktree",
    "worktree": "$wt"
   },
   "force": false
  }
 }
]
