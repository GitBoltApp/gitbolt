{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitBolt",
  "version": "0.1.0",
  "identifier": "dev.gitbolt.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitBolt",
        "width": 1600,
        "height": 900,
        "minWidth": 900,
        "minHeight": 500,
        "decorations": true,
        "create": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "A fast desktop Git client",
    "longDescription": "A fast desktop Git client.",
    "icon": ["icons/128x128@2x.png", "icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/icon.png"],
    "linux": {
      "deb": { "depends": ["libgtk-4-1", "git (>= 1:2.30)"], "section": "vcs", "files": { "/usr/share/icons/hicolor/scalable/apps/gitbolt.svg": "icons/source.svg" } }
    }
  }
}
