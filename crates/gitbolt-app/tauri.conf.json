{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitBolt",
  "version": "0.2.0",
  "identifier": "dev.gitbolt.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitBolt",
        "width": 1600,
        "height": 900,
        "minWidth": 900,
        "minHeight": 500,
        "decorations": true,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "homepage": "https://github.com/GitBoltApp/gitbolt",
    "shortDescription": "Fast, keyboard-friendly Git client",
    "longDescription": "GitBolt is a fast, keyboard-friendly desktop Git client with a commit graph\nat its heart: the lane graph down the middle, the branch and remote sidebar,\nthe commit details on the right, and workflows driven from context menus and\nthe keyboard.\n\nIt reads repositories with gitoxide and writes through the git command line,\nso your hooks, config and credentials behave exactly as they do in a terminal.\n\nStaging of files, hunks and lines; an undo history of the last 50 operations;\ninteractive rebase; merge and pull requests on GitLab and GitHub, stacks\nincluded. No account and no telemetry.",
    "icon": ["icons/128x128@2x.png", "icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/icon.png"],
    "linux": {
      "deb": { "depends": ["libgtk-4-1", "git (>= 1:2.40)"], "section": "vcs",
        "desktopTemplate": "linux/GitBolt.desktop.hbs", "files": {
        "/usr/share/metainfo/dev.gitbolt.desktop.metainfo.xml": "../../target/package-meta/dev.gitbolt.desktop.metainfo.xml",
        "/usr/share/icons/hicolor/32x32/apps/dev.gitbolt.desktop.png": "icons/32x32.png",
        "/usr/share/icons/hicolor/64x64/apps/dev.gitbolt.desktop.png": "icons/64x64.png",
        "/usr/share/icons/hicolor/128x128/apps/dev.gitbolt.desktop.png": "icons/128x128.png",
        "/usr/share/icons/hicolor/256x256/apps/dev.gitbolt.desktop.png": "icons/128x128@2x.png",
        "/usr/share/icons/hicolor/512x512/apps/dev.gitbolt.desktop.png": "icons/icon.png",
        "/usr/share/icons/hicolor/scalable/apps/dev.gitbolt.desktop.svg": "icons/source.svg",
        "/usr/share/icons/hicolor/scalable/apps/gitbolt.svg": "icons/source.svg",
        "/usr/share/doc/gitbolt/copyright": "../../target/package-meta/copyright",
        "/usr/share/doc/gitbolt/LICENSE": "../../LICENSE",
        "/usr/share/doc/gitbolt/THIRD-PARTY-NOTICES-rust.txt": "../../target/licenses/THIRD-PARTY-NOTICES-rust.txt",
        "/usr/share/doc/gitbolt/THIRD-PARTY-NOTICES-ui.txt": "../../ui/dist/licenses/THIRD-PARTY-NOTICES-ui.txt",
        "/usr/share/doc/gitbolt/CEF-LICENSE.txt": "../../target/licenses/CEF-LICENSE.txt",
        "/usr/share/doc/gitbolt/CHROMIUM-CREDITS.html.gz": "../../target/licenses/CHROMIUM-CREDITS.html.gz",
        "/usr/share/doc/gitbolt/DICTIONARY-en-US-LICENSE.txt": "dictionaries/en-US-LICENSE.txt",
        "/usr/share/GitBolt/dictionaries/en-US-10-1.bdic": "dictionaries/en-US-10-1.bdic"
      } }
    }
  }
}
